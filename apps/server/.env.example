NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:3000

# Required for login and sessions. Test credentials belong in .env.test instead.
# DATABASE_URL=postgresql://commit_health:change_me@localhost:5432/commit_health?schema=public

# Google Cloud OAuth client type: Web application. Keep both values empty until configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
# lax for localhost / same-site HTTPS; none only for cross-site HTTPS production deployments.
COOKIE_SAME_SITE=lax
