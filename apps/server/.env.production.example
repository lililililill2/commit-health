NODE_ENV=production
FRONTEND_URL=https://commit-health.vercel.app
CORS_ORIGIN=https://commit-health.vercel.app
GOOGLE_CALLBACK_URL=https://commit-health.vercel.app/api/auth/google/callback
COOKIE_SAME_SITE=lax

# Set these only on the backend project. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Runtime: pooled Neon connection (NestJS always uses DATABASE_URL).
# DATABASE_URL=postgresql://user:password@your-production-host-pooler/commit_health_prod?sslmode=require
# Prisma CLI: direct connection to the same database, without the -pooler hostname.
# DATABASE_URL_UNPOOLED=postgresql://user:password@your-production-host/commit_health_prod?sslmode=require
