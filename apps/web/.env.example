# Public value: included in the browser bundle. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Vercel Production: NEXT_PUBLIC_API_BASE_URL=/api
# Server-only HTTPS origin of the deployed NestJS project (no /api suffix).
# API_SERVER_ORIGIN=https://your-api-project.vercel.app

# The bundled default shoulder model is public. Set all four values to replace it.
# NEXT_PUBLIC_STRETCH_POSE_MODEL_URL=https://teachablemachine.withgoogle.com/models/your-model/
# NEXT_PUBLIC_STRETCH_POSE_LEFT_LABEL=left
# NEXT_PUBLIC_STRETCH_POSE_RIGHT_LABEL=right
# NEXT_PUBLIC_STRETCH_POSE_NEUTRAL_LABEL=default
# Set to false if the model was trained on non-mirrored video.
# NEXT_PUBLIC_STRETCH_POSE_FLIP_INPUT=false
