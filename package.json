{
  "name": "commit-health",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.30.3 <11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@commit-health/web",
    "dev:server": "turbo run dev --filter=@commit-health/server",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:db": "turbo run test:db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @commit-health/server prisma:generate",
    "prisma:validate": "pnpm --filter @commit-health/server prisma:validate",
    "prisma:migrate": "pnpm --filter @commit-health/server prisma:migrate",
    "prisma:deploy": "pnpm --filter @commit-health/server prisma:deploy",
    "prisma:test:deploy": "pnpm --filter @commit-health/server prisma:test:deploy",
    "prisma:studio": "pnpm --filter @commit-health/server prisma:studio"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
